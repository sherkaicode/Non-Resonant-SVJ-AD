07:37:59 define vl~ = ve~ vm~ vt~
07:37:59 define gv = gv11 gv12 gv21 gv22
07:37:59 define gv~ = gv11~ gv12~ gv21~ gv22~
07:37:59 define j = g u c t d b s g u~ c~ t~ d~ b~ s~
