07:37:59 set group_subprocesses Auto
07:37:59 set ignore_six_quark_processes False
07:37:59 set max_t_for_channel 99
07:37:59 set loop_optimized_output True
07:37:59 set low_mem_multicore_nlo_generation False
07:37:59 set default_unset_couplings 99
07:37:59 set zerowidth_tchannel True
07:37:59 set loop_color_flows False
07:37:59 set gauge unitary
07:37:59 set complex_mass_scheme False
