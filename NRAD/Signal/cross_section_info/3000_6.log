11:33:35 set group_subprocesses Auto
11:33:35 set ignore_six_quark_processes False
11:33:35 set max_t_for_channel 99
11:33:35 set loop_optimized_output True
11:33:35 set low_mem_multicore_nlo_generation False
11:33:35 set default_unset_couplings 99
11:33:35 set zerowidth_tchannel True
11:33:35 set loop_color_flows False
11:33:35 set gauge unitary
11:33:35 set complex_mass_scheme False
