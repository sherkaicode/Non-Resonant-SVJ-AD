11:33:35 import model /cvmfs/atlas.cern.ch/repo/sw/Generators/madgraph/models/l\
11:33:35 atest/DM/DMsimp_tchannel
11:33:35 define p = g u c d s u~ c~ d~ s~
11:33:35 define j = g u c d s u~ c~ d~ s~
11:33:35 define l+ = e+ mu+
11:33:35 define l- = e- mu-
11:33:35 define vl = ve vm vt
11:33:35 define vl~ = ve~ vm~ vt~
11:33:35 define gv = gv11 gv12 gv21 gv22
11:33:35 define gv~ = gv11~ gv12~ gv21~ gv22~
11:33:35 define j = g u c t d b s g u~ c~ t~ d~ b~ s~
11:33:35 generate p p > gv gv~
11:33:35 add process p p > gv gv~ j
11:33:35 add process p p > gv gv~ j j
11:33:35 output -f -nojpeg
11:33:35 Py:MadGraphUtils     INFO run_card:
11:33:35 #*********************************************************************
11:33:35 #                       MadGraph5_aMC@NLO                            *
11:33:35 #                                                                    *
11:33:35 #                     run_card.dat MadEvent                          *
11:33:35 #                                                                    *
11:33:35 #  This file is used to set the parameters of the run.               *
11:33:35 #                                                                    *
11:33:35 #  Some notation/conventions:                                        *
11:33:35 #                                                                    *
11:33:35 #   Lines starting with a '# ' are info or comments                  *
11:33:35 #                                                                    *
11:33:35 #   mind the format:   value    = variable     ! comment             *
11:33:35 #                                                                    *
11:33:35 #   To display more options, you can type the command:               *
11:33:35 #      update full_run_card                                          *
11:33:35 #*********************************************************************
11:33:35 #
11:33:35 #*********************************************************************
11:33:35 # Tag name for the run (one word)                                    *
11:33:35 #*********************************************************************
11:33:35 tag_1     = run_tag ! name of the run
11:33:35 #*********************************************************************
11:33:35 # Number of events and rnd seed                                      *
11:33:35 # Warning: Do not generate more than 1M events in a single run       *
11:33:35 #*********************************************************************
11:33:35 1500000 = nevents   ! Number of unweighted events requested
11:33:35 123456   = iseed     ! rnd seed (0=assigned automatically=default))
11:33:35 #*********************************************************************
11:33:35 # Collider type and energy                                           *
11:33:35 # lpp: 0=No PDF, 1=proton, -1=antiproton, 2=photon from proton,      *
11:33:35 #                3=photon from electron, 4=photon from muon          *
11:33:35 #*********************************************************************
11:33:35 1        = lpp1    ! beam 1 type
11:33:35 1        = lpp2    ! beam 2 type
11:33:35 6500.0     = ebeam1    ! beam 1 total energy in GeV
11:33:35 6500.0     = ebeam2    ! beam 2 total energy in GeV
11:33:35 # To see polarised beam options: type "update beam_pol"
11:33:35 
11:33:35 #*********************************************************************
11:33:35 # PDF CHOICE: this automatically fixes also alpha_s and its evol.    *
11:33:35 #*********************************************************************
11:33:35 lhapdf    = pdlabel       ! PDF set
11:33:35 260000    = lhaid       ! if pdlabel=lhapdf, this is the lhapdf number
11:33:35 # To see heavy ion options: type "update ion_pdf"
11:33:35 #*********************************************************************
11:33:35 # Renormalization and factorization scales                           *
11:33:35 #*********************************************************************
11:33:35 False = fixed_ren_scale  ! if .true. use fixed ren scale
11:33:35 False        = fixed_fac_scale  ! if .true. use fixed fac scale
11:33:35 91.188  = scale            ! fixed ren scale
11:33:35 91.188  = dsqrt_q2fact1    ! fixed fact scale for pdf1
11:33:35 91.188  = dsqrt_q2fact2    ! fixed fact scale for pdf2
11:33:35 -1 = dynamical_scale_choice ! Choose one of the preselected dynamical choices
11:33:35 1.0  = scalefact        ! scale factor for event-by-event scales
11:33:35 #*********************************************************************
11:33:35 # Type and output format
11:33:35 #*********************************************************************
11:33:35 False     = gridpack  !True = setting up the grid pack
11:33:35 -1.0 = time_of_flight ! threshold (in mm) below which the invariant livetime is not written (-1 means not written)
11:33:35 average =  event_norm       ! average/sum. Normalization of the weight in the LHEF
11:33:35 #*********************************************************************
11:33:35 # Matching parameter (MLM only)
11:33:35 #*********************************************************************
11:33:35 1 = ickkw            ! 0 no matching, 1 MLM
11:33:35 1.0 = alpsfact         ! scale factor for QCD emission vx
11:33:35 False = chcluster        ! cluster only according to channel diag
11:33:35 4 = asrwgtflavor     ! highest quark flavor for a_s reweight
11:33:35 True  = auto_ptj_mjj  ! Automatic setting of ptj and mjj if xqcut >0
11:33:35 ! (turn off for VBF and single top processes)
11:33:35 100   = xqcut     ! minimum kt jet measure between partons
11:33:35 
11:33:35 #***********************************************************************
11:33:35 # Turn on either the ktdurham or ptlund cut to activate                *
11:33:35 # CKKW(L) merging with Pythia8 [arXiv:1410.3012, arXiv:1109.4829]      *
11:33:35 #***********************************************************************
11:33:35 -1.0  =  ktdurham
11:33:35 0.4   =  dparameter
11:33:35 -1.0  =  ptlund
11:33:35 1, 2, 3, 4, 5, 6, 21, 9000005, 9000006, 9000007, 9000008, 9000009, 9000010, 9000011, 9000012, 9000013, 9000014, 9000015, 9000016, 9000017, 9000018, 9000019, 9000020, 9000021, 9000022, 9000023, 9000024, 9000025, 9000026, 9000027, 9000028  =  pdgs_for_merging_cut ! PDGs for two cuts above
11:33:35 
11:33:35 #*********************************************************************
11:33:35 #
11:33:35 #*********************************************************************
11:33:35 # handling of the helicities:
11:33:35 #  0: sum over all helicities
11:33:35 #  1: importance sampling over helicities
11:33:35 #*********************************************************************
11:33:35 0  = nhel          ! using helicities importance sampling or not.
11:33:35 #*********************************************************************
11:33:35 # Generation bias, check the wiki page below for more information:   *
11:33:35 #  'cp3.irmp.ucl.ac.be/projects/madgraph/wiki/LOEventGenerationBias' *
11:33:35 #*********************************************************************
11:33:35 None = bias_module  ! Bias type of bias, [None, ptj_bias, -custom_folder-]
11:33:35 {} = bias_parameters ! Specifies the parameters of the module.
11:33:35 #
11:33:35 #*******************************
11:33:35 # Parton level cuts definition *
11:33:35 #*******************************
11:33:35 #
11:33:35 #
11:33:35 #*********************************************************************
11:33:35 # BW cutoff (M+/-bwcutoff*Gamma) ! Define on/off-shell for "$" and decay
11:33:35 #*********************************************************************
11:33:35 15.0  = bwcutoff      ! (M+/-bwcutoff*Gamma)
11:33:35 #*********************************************************************
11:33:35 # Standard Cuts                                                      *
11:33:35 #*********************************************************************
11:33:35 # Minimum and maximum pt's (for max, -1 means no cut)                *
11:33:35 #*********************************************************************
11:33:35 20.0  = ptj       ! minimum pt for the jets
11:33:35 0.0  = ptb       ! minimum pt for the b
11:33:35 -1.0  = ptjmax    ! maximum pt for the jets
11:33:35 -1.0  = ptbmax    ! maximum pt for the b
11:33:35 {} = pt_min_pdg ! pt cut for other particles (use pdg code). Applied on particle and anti-particle
11:33:35 {}	= pt_max_pdg ! pt cut for other particles (syntax e.g. {6: 100, 25: 50})
11:33:35 #
11:33:35 # For display option for energy cut in the partonic center of mass frame type 'update ecut'
11:33:35 #
11:33:35 #*********************************************************************
11:33:35 # Maximum and minimum absolute rapidity (for max, -1 means no cut)   *
11:33:35 #*********************************************************************
11:33:35 5.0 = etaj    ! max rap for the jets
11:33:35 -1.0  = etab    ! max rap for the b
11:33:35 0.0  = etabmin ! min rap for the b
11:33:35 {} = eta_min_pdg ! rap cut for other particles (use pdg code). Applied on particle and anti-particle
11:33:35 {} = eta_max_pdg ! rap cut for other particles (syntax e.g. {6: 2.5, 23: 5})
11:33:35 #*********************************************************************
11:33:35 # Minimum and maximum DeltaR distance                                *
11:33:35 #*********************************************************************
11:33:35 0.0 = drjj    ! min distance between jets
11:33:35 0.0   = drbb    ! min distance between b's
11:33:35 0.0   = drbj    ! min distance between b and jet
11:33:35 -1.0  = drjjmax ! max distance between jets
11:33:35 -1.0  = drbbmax ! max distance between b's
11:33:35 -1.0  = drbjmax ! max distance between b and jet
11:33:35 #*********************************************************************
11:33:35 # Minimum and maximum invariant mass for pairs                       *
11:33:35 #*********************************************************************
11:33:35 0.0   = mmjj    ! min invariant mass of a jet pair
11:33:35 0.0   = mmbb    ! min invariant mass of a b pair
11:33:35 -1.0  = mmjjmax ! max invariant mass of a jet pair
11:33:35 -1.0  = mmbbmax ! max invariant mass of a b pair
11:33:35 {} = mxx_min_pdg ! min invariant mass of a pair of particles X/X~ (e.g. {6:250})
11:33:35 {'default': False} = mxx_only_part_antipart ! if True the invariant mass is applied only
11:33:35 ! to pairs of particle/antiparticle and not to pairs of the same pdg codes.
11:33:35 #*********************************************************************
11:33:35 # Inclusive cuts                                                     *
11:33:35 #*********************************************************************
11:33:35 0.0  = ptheavy   ! minimum pt for at least one heavy final state
11:33:35 0.0  = xptj ! minimum pt for at least one jet
11:33:35 0.0  = xptb ! minimum pt for at least one b
11:33:35 #*********************************************************************
11:33:35 # Control the pt's of the jets sorted by pt                          *
11:33:35 #*********************************************************************
11:33:35 0.0   = ptj1min ! minimum pt for the leading jet in pt
11:33:35 0.0   = ptj2min ! minimum pt for the second jet in pt
11:33:35 -1.0  = ptj1max ! maximum pt for the leading jet in pt
11:33:35 -1.0  = ptj2max ! maximum pt for the second jet in pt
11:33:35 0   = cutuse  ! reject event if fails any (0) / all (1) jet pt cuts
11:33:35 #*********************************************************************
11:33:35 # Control the Ht(k)=Sum of k leading jets                            *
11:33:35 #*********************************************************************
11:33:35 0.0   = htjmin ! minimum jet HT=Sum(jet pt)
11:33:35 -1.0  = htjmax ! maximum jet HT=Sum(jet pt)
11:33:35 0.0   = ihtmin  !inclusive Ht for all partons (including b)
11:33:35 -1.0  = ihtmax  !inclusive Ht for all partons (including b)
11:33:35 #*********************************************************************
11:33:35 # WBF cuts                                                           *
11:33:35 #*********************************************************************
11:33:35 0.0   = xetamin ! minimum rapidity for two jets in the WBF case
11:33:35 0.0   = deltaeta ! minimum rapidity for two jets in the WBF case
11:33:35 #*********************************************************************
11:33:35 # maximal pdg code for quark to be considered as a light jet         *
11:33:35 # (otherwise b cuts are applied)                                     *
11:33:35 #*********************************************************************
11:33:35 4 = maxjetflavor    ! Maximum jet pdg code
11:33:35 #*********************************************************************
11:33:35 #
11:33:35 #*********************************************************************
11:33:35 # Store info for systematics studies                                 *
11:33:35 # WARNING: Do not use for interference type of computation           *
11:33:35 #*********************************************************************
11:33:35 True  = use_syst        ! Enable systematics studies
11:33:35 #
11:33:35 systematics = systematics_program   ! none, systematics [python], SysCalc [depreceted, C++]
11:33:35 ['--mur=0.5,1.0,2.0','--dyn=-1','--muf=0.5,1.0,2.0','--weight_info=MUR%(mur).1f_MUF%(muf).1f_PDF%(pdf)i','--pdf=NNPDF30_nlo_as_0118,PDF4LHC15_nlo_30_pdfas,NNPDF30_nlo_as_0119@0,NNPDF30_nlo_as_0117@0,CT14nlo@0,MMHT2014nlo68clas118@0','--remove_wgts=".*MUR0.5_MUF2.0.*|.*MUR2.0_MUF0.5.*"'] = systematics_arguments   ! see: https://cp3.irmp.ucl.ac.be/projects/madgraph/wiki/Systematics#Systematicspythonmodule
11:33:35 # Syscalc is deprecated but to see the associate options type'update syscalc'
11:33:35  123456   = python_seed
