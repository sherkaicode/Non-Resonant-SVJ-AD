05:12:09 #*     run as ./bin/mg5_aMC  filename                       *
05:12:09 #*                                                          *
05:12:09 #************************************************************
05:12:09 set group_subprocesses Auto
05:12:09 set ignore_six_quark_processes False
05:12:09 set max_t_for_channel 99
05:12:09 set loop_optimized_output True
05:12:09 set low_mem_multicore_nlo_generation False
05:12:09 set default_unset_couplings 99
05:12:09 set zerowidth_tchannel True
05:12:09 set loop_color_flows False
05:12:09 set gauge unitary
05:12:09 set complex_mass_scheme False
