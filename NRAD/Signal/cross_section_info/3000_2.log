12:02:41 set group_subprocesses Auto
12:02:41 set ignore_six_quark_processes False
12:02:41 set max_t_for_channel 99
12:02:41 set loop_optimized_output True
12:02:41 set low_mem_multicore_nlo_generation False
12:02:41 set default_unset_couplings 99
12:02:41 set zerowidth_tchannel True
12:02:41 set loop_color_flows False
