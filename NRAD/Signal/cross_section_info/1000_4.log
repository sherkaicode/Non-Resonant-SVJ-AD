04:02:31 set group_subprocesses Auto
04:02:31 set ignore_six_quark_processes False
04:02:31 set max_t_for_channel 99
04:02:31 set loop_optimized_output True
04:02:31 set low_mem_multicore_nlo_generation False
04:02:31 set default_unset_couplings 99
04:02:31 set zerowidth_tchannel True
04:02:31 set loop_color_flows False
