04:02:31 Py:MadGraphUtils     INFO run_card:
04:02:31 #*********************************************************************
04:02:31 #                       MadGraph5_aMC@NLO                            *
04:02:31 #                                                                    *
04:02:31 #                     run_card.dat MadEvent                          *
04:02:31 #                                                                    *
04:02:31 #  This file is used to set the parameters of the run.               *
04:02:31 #                                                                    *
04:02:31 #  Some notation/conventions:                                        *
04:02:31 #                                                                    *
04:02:31 #   Lines starting with a '# ' are info or comments                  *
04:02:31 #                                                                    *
04:02:31 #   mind the format:   value    = variable     ! comment             *
04:02:31 #                                                                    *
04:02:31 #   To display more options, you can type the command:               *
04:02:31 #      update full_run_card                                          *
04:02:31 #*********************************************************************
04:02:31 #
04:02:31 #*********************************************************************
04:02:31 # Tag name for the run (one word)                                    *
04:02:31 #*********************************************************************
04:02:31 tag_1     = run_tag ! name of the run
04:02:31 #*********************************************************************
04:02:31 # Number of events and rnd seed                                      *
04:02:31 # Warning: Do not generate more than 1M events in a single run       *
04:02:31 #*********************************************************************
04:02:31 1500000 = nevents   ! Number of unweighted events requested
04:02:31 123456   = iseed     ! rnd seed (0=assigned automatically=default))
04:02:31 #*********************************************************************
04:02:31 # Collider type and energy                                           *
04:02:31 # lpp: 0=No PDF, 1=proton, -1=antiproton, 2=photon from proton,      *
04:02:31 #                3=photon from electron, 4=photon from muon          *
04:02:31 #*********************************************************************
04:02:31 1        = lpp1    ! beam 1 type
04:02:31 1        = lpp2    ! beam 2 type
04:02:31 6500.0     = ebeam1    ! beam 1 total energy in GeV
04:02:31 6500.0     = ebeam2    ! beam 2 total energy in GeV
04:02:31 # To see polarised beam options: type "update beam_pol"
04:02:31 
04:02:31 #*********************************************************************
04:02:31 # PDF CHOICE: this automatically fixes also alpha_s and its evol.    *
04:02:31 #*********************************************************************
04:02:31 lhapdf    = pdlabel       ! PDF set
04:02:31 260000    = lhaid       ! if pdlabel=lhapdf, this is the lhapdf number
04:02:31 # To see heavy ion options: type "update ion_pdf"
04:02:31 #*********************************************************************
04:02:31 # Renormalization and factorization scales                           *
04:02:31 #*********************************************************************
04:02:31 False = fixed_ren_scale  ! if .true. use fixed ren scale
04:02:31 False        = fixed_fac_scale  ! if .true. use fixed fac scale
04:02:31 91.188  = scale            ! fixed ren scale
04:02:31 91.188  = dsqrt_q2fact1    ! fixed fact scale for pdf1
04:02:31 91.188  = dsqrt_q2fact2    ! fixed fact scale for pdf2
04:02:31 -1 = dynamical_scale_choice ! Choose one of the preselected dynamical choices
04:02:31 1.0  = scalefact        ! scale factor for event-by-event scales
04:02:31 #*********************************************************************
04:02:31 # Type and output format
04:02:31 #*********************************************************************
04:02:31 False     = gridpack  !True = setting up the grid pack
04:02:31 -1.0 = time_of_flight ! threshold (in mm) below which the invariant livetime is not written (-1 means not written)
04:02:31 average =  event_norm       ! average/sum. Normalization of the weight in the LHEF
04:02:31 #*********************************************************************
04:02:31 # Matching parameter (MLM only)
04:02:31 #*********************************************************************
04:02:31 1 = ickkw            ! 0 no matching, 1 MLM
04:02:31 1.0 = alpsfact         ! scale factor for QCD emission vx
04:02:31 False = chcluster        ! cluster only according to channel diag
04:02:31 4 = asrwgtflavor     ! highest quark flavor for a_s reweight
04:02:31 True  = auto_ptj_mjj  ! Automatic setting of ptj and mjj if xqcut >0
04:02:31 ! (turn off for VBF and single top processes)
04:02:31 100   = xqcut     ! minimum kt jet measure between partons
04:02:31 
04:02:31 #***********************************************************************
04:02:31 # Turn on either the ktdurham or ptlund cut to activate                *
04:02:31 # CKKW(L) merging with Pythia8 [arXiv:1410.3012, arXiv:1109.4829]      *
04:02:31 #***********************************************************************
04:02:31 -1.0  =  ktdurham
04:02:31 0.4   =  dparameter
04:02:31 -1.0  =  ptlund
04:02:31 1, 2, 3, 4, 5, 6, 21, 9000005, 9000006, 9000007, 9000008, 9000009, 9000010, 9000011, 9000012, 9000013, 9000014, 9000015, 9000016, 9000017, 9000018, 9000019, 9000020, 9000021, 9000022, 9000023, 9000024, 9000025, 9000026, 9000027, 9000028  =  pdgs_for_merging_cut ! PDGs for two cuts above
04:02:31 
04:02:31 #*********************************************************************
04:02:31 #
04:02:31 #*********************************************************************
04:02:31 # handling of the helicities:
04:02:31 #  0: sum over all helicities
04:02:31 #  1: importance sampling over helicities
04:02:31 #*********************************************************************
04:02:31 0  = nhel          ! using helicities importance sampling or not.
04:02:31 #*********************************************************************
04:02:31 # Generation bias, check the wiki page below for more information:   *
04:02:31 #  'cp3.irmp.ucl.ac.be/projects/madgraph/wiki/LOEventGenerationBias' *
04:02:31 #*********************************************************************
04:02:31 None = bias_module  ! Bias type of bias, [None, ptj_bias, -custom_folder-]
04:02:31 {} = bias_parameters ! Specifies the parameters of the module.
04:02:31 #
04:02:31 #*******************************
04:02:31 # Parton level cuts definition *
04:02:31 #*******************************
04:02:31 #
04:02:31 #
04:02:31 #*********************************************************************
04:02:31 # BW cutoff (M+/-bwcutoff*Gamma) ! Define on/off-shell for "$" and decay
04:02:31 #*********************************************************************
04:02:31 15.0  = bwcutoff      ! (M+/-bwcutoff*Gamma)
04:02:31 #*********************************************************************
04:02:31 # Standard Cuts                                                      *
04:02:31 #*********************************************************************
04:02:31 # Minimum and maximum pt's (for max, -1 means no cut)                *
04:02:31 #*********************************************************************
04:02:31 20.0  = ptj       ! minimum pt for the jets
04:02:31 0.0  = ptb       ! minimum pt for the b
04:02:31 -1.0  = ptjmax    ! maximum pt for the jets
04:02:31 -1.0  = ptbmax    ! maximum pt for the b
04:02:31 {} = pt_min_pdg ! pt cut for other particles (use pdg code). Applied on particle and anti-particle
04:02:31 {}	= pt_max_pdg ! pt cut for other particles (syntax e.g. {6: 100, 25: 50})
04:02:31 #
04:02:31 # For display option for energy cut in the partonic center of mass frame type 'update ecut'
04:02:31 #
04:02:31 #*********************************************************************
04:02:31 # Maximum and minimum absolute rapidity (for max, -1 means no cut)   *
04:02:31 #*********************************************************************
04:02:31 5.0 = etaj    ! max rap for the jets
04:02:31 -1.0  = etab    ! max rap for the b
04:02:31 0.0  = etabmin ! min rap for the b
04:02:31 {} = eta_min_pdg ! rap cut for other particles (use pdg code). Applied on particle and anti-particle
04:02:31 {} = eta_max_pdg ! rap cut for other particles (syntax e.g. {6: 2.5, 23: 5})
04:02:31 #*********************************************************************
04:02:31 # Minimum and maximum DeltaR distance                                *
04:02:31 #*********************************************************************
04:02:31 0.0 = drjj    ! min distance between jets
04:02:31 0.0   = drbb    ! min distance between b's
04:02:31 0.0   = drbj    ! min distance between b and jet
04:02:31 -1.0  = drjjmax ! max distance between jets
04:02:31 -1.0  = drbbmax ! max distance between b's
04:02:31 -1.0  = drbjmax ! max distance between b and jet
04:02:31 #*********************************************************************
04:02:31 # Minimum and maximum invariant mass for pairs                       *
04:02:31 #*********************************************************************
04:02:31 0.0   = mmjj    ! min invariant mass of a jet pair
04:02:31 0.0   = mmbb    ! min invariant mass of a b pair
04:02:31 -1.0  = mmjjmax ! max invariant mass of a jet pair
04:02:31 -1.0  = mmbbmax ! max invariant mass of a b pair
04:02:31 {} = mxx_min_pdg ! min invariant mass of a pair of particles X/X~ (e.g. {6:250})
04:02:31 {'default': False} = mxx_only_part_antipart ! if True the invariant mass is applied only
04:02:31 ! to pairs of particle/antiparticle and not to pairs of the same pdg codes.
04:02:31 #*********************************************************************
04:02:31 # Inclusive cuts                                                     *
04:02:31 #*********************************************************************
04:02:31 0.0  = ptheavy   ! minimum pt for at least one heavy final state
04:02:31 0.0  = xptj ! minimum pt for at least one jet
04:02:31 0.0  = xptb ! minimum pt for at least one b
04:02:31 #*********************************************************************
04:02:31 # Control the pt's of the jets sorted by pt                          *
04:02:31 #*********************************************************************
04:02:31 0.0   = ptj1min ! minimum pt for the leading jet in pt
04:02:31 0.0   = ptj2min ! minimum pt for the second jet in pt
04:02:31 -1.0  = ptj1max ! maximum pt for the leading jet in pt
04:02:31 -1.0  = ptj2max ! maximum pt for the second jet in pt
04:02:31 0   = cutuse  ! reject event if fails any (0) / all (1) jet pt cuts
04:02:31 #*********************************************************************
04:02:31 # Control the Ht(k)=Sum of k leading jets                            *
04:02:31 #*********************************************************************
04:02:31 0.0   = htjmin ! minimum jet HT=Sum(jet pt)
04:02:31 -1.0  = htjmax ! maximum jet HT=Sum(jet pt)
04:02:31 0.0   = ihtmin  !inclusive Ht for all partons (including b)
04:02:31 -1.0  = ihtmax  !inclusive Ht for all partons (including b)
04:02:31 #*********************************************************************
04:02:31 # WBF cuts                                                           *
04:02:31 #*********************************************************************
04:02:31 0.0   = xetamin ! minimum rapidity for two jets in the WBF case
04:02:31 0.0   = deltaeta ! minimum rapidity for two jets in the WBF case
04:02:31 #*********************************************************************
04:02:31 # maximal pdg code for quark to be considered as a light jet         *
04:02:31 # (otherwise b cuts are applied)                                     *
04:02:31 #*********************************************************************
04:02:31 4 = maxjetflavor    ! Maximum jet pdg code
04:02:31 #*********************************************************************
04:02:31 #
04:02:31 #*********************************************************************
04:02:31 # Store info for systematics studies                                 *
04:02:31 # WARNING: Do not use for interference type of computation           *
04:02:31 #*********************************************************************
04:02:31 True  = use_syst        ! Enable systematics studies
04:02:31 #
04:02:31 systematics = systematics_program   ! none, systematics [python], SysCalc [depreceted, C++]
04:02:31 ['--mur=0.5,1.0,2.0','--dyn=-1','--muf=0.5,1.0,2.0','--weight_info=MUR%(mur).1f_MUF%(muf).1f_PDF%(pdf)i','--pdf=NNPDF30_nlo_as_0118,PDF4LHC15_nlo_30_pdfas,NNPDF30_nlo_as_0119@0,NNPDF30_nlo_as_0117@0,CT14nlo@0,MMHT2014nlo68clas118@0','--remove_wgts=".*MUR0.5_MUF2.0.*|.*MUR2.0_MUF0.5.*"'] = systematics_arguments   ! see: https://cp3.irmp.ucl.ac.be/projects/madgraph/wiki/Systematics#Systematicspythonmodule
04:02:31 # Syscalc is deprecated but to see the associate options type'update syscalc'
04:02:31  123456   = python_seed
