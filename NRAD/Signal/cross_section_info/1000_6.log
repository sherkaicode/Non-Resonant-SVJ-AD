06:52:56 Py:MadGraphUtils     INFO run_card:
06:52:56 #*********************************************************************
06:52:56 #                       MadGraph5_aMC@NLO                            *
06:52:56 #                                                                    *
06:52:56 #                     run_card.dat MadEvent                          *
06:52:56 #                                                                    *
06:52:56 #  This file is used to set the parameters of the run.               *
06:52:56 #                                                                    *
06:52:56 #  Some notation/conventions:                                        *
06:52:56 #                                                                    *
06:52:56 #   Lines starting with a '# ' are info or comments                  *
06:52:56 #                                                                    *
06:52:56 #   mind the format:   value    = variable     ! comment             *
06:52:56 #                                                                    *
06:52:56 #   To display more options, you can type the command:               *
06:52:56 #      update full_run_card                                          *
06:52:56 #*********************************************************************
06:52:56 #
06:52:56 #*********************************************************************
06:52:56 # Tag name for the run (one word)                                    *
06:52:56 #*********************************************************************
06:52:56 tag_1     = run_tag ! name of the run
06:52:56 #*********************************************************************
06:52:56 # Number of events and rnd seed                                      *
06:52:56 # Warning: Do not generate more than 1M events in a single run       *
06:52:56 #*********************************************************************
06:52:56 1500000 = nevents   ! Number of unweighted events requested
06:52:56 123456   = iseed     ! rnd seed (0=assigned automatically=default))
06:52:56 #*********************************************************************
06:52:56 # Collider type and energy                                           *
06:52:56 # lpp: 0=No PDF, 1=proton, -1=antiproton, 2=photon from proton,      *
06:52:56 #                3=photon from electron, 4=photon from muon          *
06:52:56 #*********************************************************************
06:52:56 1        = lpp1    ! beam 1 type
06:52:56 1        = lpp2    ! beam 2 type
06:52:56 6500.0     = ebeam1    ! beam 1 total energy in GeV
06:52:56 6500.0     = ebeam2    ! beam 2 total energy in GeV
06:52:56 # To see polarised beam options: type "update beam_pol"
06:52:56 
06:52:56 #*********************************************************************
06:52:56 # PDF CHOICE: this automatically fixes also alpha_s and its evol.    *
06:52:56 #*********************************************************************
06:52:56 lhapdf    = pdlabel       ! PDF set
06:52:56 260000    = lhaid       ! if pdlabel=lhapdf, this is the lhapdf number
06:52:56 # To see heavy ion options: type "update ion_pdf"
06:52:56 #*********************************************************************
06:52:56 # Renormalization and factorization scales                           *
06:52:56 #*********************************************************************
06:52:56 False = fixed_ren_scale  ! if .true. use fixed ren scale
06:52:56 False        = fixed_fac_scale  ! if .true. use fixed fac scale
06:52:56 91.188  = scale            ! fixed ren scale
06:52:56 91.188  = dsqrt_q2fact1    ! fixed fact scale for pdf1
06:52:56 91.188  = dsqrt_q2fact2    ! fixed fact scale for pdf2
06:52:56 -1 = dynamical_scale_choice ! Choose one of the preselected dynamical choices
06:52:56 1.0  = scalefact        ! scale factor for event-by-event scales
06:52:56 #*********************************************************************
06:52:56 # Type and output format
06:52:56 #*********************************************************************
06:52:56 False     = gridpack  !True = setting up the grid pack
06:52:56 -1.0 = time_of_flight ! threshold (in mm) below which the invariant livetime is not written (-1 means not written)
06:52:56 average =  event_norm       ! average/sum. Normalization of the weight in the LHEF
06:52:56 #*********************************************************************
06:52:56 # Matching parameter (MLM only)
06:52:56 #*********************************************************************
06:52:56 1 = ickkw            ! 0 no matching, 1 MLM
06:52:56 1.0 = alpsfact         ! scale factor for QCD emission vx
06:52:56 False = chcluster        ! cluster only according to channel diag
06:52:56 4 = asrwgtflavor     ! highest quark flavor for a_s reweight
06:52:56 True  = auto_ptj_mjj  ! Automatic setting of ptj and mjj if xqcut >0
06:52:56 ! (turn off for VBF and single top processes)
06:52:56 100   = xqcut     ! minimum kt jet measure between partons
06:52:56 
06:52:56 #***********************************************************************
06:52:56 # Turn on either the ktdurham or ptlund cut to activate                *
06:52:56 # CKKW(L) merging with Pythia8 [arXiv:1410.3012, arXiv:1109.4829]      *
06:52:56 #***********************************************************************
06:52:56 -1.0  =  ktdurham
06:52:56 0.4   =  dparameter
06:52:56 -1.0  =  ptlund
06:52:56 1, 2, 3, 4, 5, 6, 21, 9000005, 9000006, 9000007, 9000008, 9000009, 9000010, 9000011, 9000012, 9000013, 9000014, 9000015, 9000016, 9000017, 9000018, 9000019, 9000020, 9000021, 9000022, 9000023, 9000024, 9000025, 9000026, 9000027, 9000028  =  pdgs_for_merging_cut ! PDGs for two cuts above
06:52:56 
06:52:56 #*********************************************************************
06:52:56 #
06:52:56 #*********************************************************************
06:52:56 # handling of the helicities:
06:52:56 #  0: sum over all helicities
06:52:56 #  1: importance sampling over helicities
06:52:56 #*********************************************************************
06:52:56 0  = nhel          ! using helicities importance sampling or not.
06:52:56 #*********************************************************************
06:52:56 # Generation bias, check the wiki page below for more information:   *
06:52:56 #  'cp3.irmp.ucl.ac.be/projects/madgraph/wiki/LOEventGenerationBias' *
06:52:56 #*********************************************************************
06:52:56 None = bias_module  ! Bias type of bias, [None, ptj_bias, -custom_folder-]
06:52:56 {} = bias_parameters ! Specifies the parameters of the module.
06:52:56 #
06:52:56 #*******************************
06:52:56 # Parton level cuts definition *
06:52:56 #*******************************
06:52:56 #
06:52:56 #
06:52:56 #*********************************************************************
06:52:56 # BW cutoff (M+/-bwcutoff*Gamma) ! Define on/off-shell for "$" and decay
06:52:56 #*********************************************************************
06:52:56 15.0  = bwcutoff      ! (M+/-bwcutoff*Gamma)
06:52:56 #*********************************************************************
06:52:56 # Standard Cuts                                                      *
06:52:56 #*********************************************************************
06:52:56 # Minimum and maximum pt's (for max, -1 means no cut)                *
06:52:56 #*********************************************************************
06:52:56 20.0  = ptj       ! minimum pt for the jets
06:52:56 0.0  = ptb       ! minimum pt for the b
06:52:56 -1.0  = ptjmax    ! maximum pt for the jets
06:52:56 -1.0  = ptbmax    ! maximum pt for the b
06:52:56 {} = pt_min_pdg ! pt cut for other particles (use pdg code). Applied on particle and anti-particle
06:52:56 {}	= pt_max_pdg ! pt cut for other particles (syntax e.g. {6: 100, 25: 50})
06:52:56 #
06:52:56 # For display option for energy cut in the partonic center of mass frame type 'update ecut'
06:52:56 #
06:52:56 #*********************************************************************
06:52:56 # Maximum and minimum absolute rapidity (for max, -1 means no cut)   *
06:52:56 #*********************************************************************
06:52:56 5.0 = etaj    ! max rap for the jets
06:52:56 -1.0  = etab    ! max rap for the b
06:52:56 0.0  = etabmin ! min rap for the b
06:52:56 {} = eta_min_pdg ! rap cut for other particles (use pdg code). Applied on particle and anti-particle
06:52:56 {} = eta_max_pdg ! rap cut for other particles (syntax e.g. {6: 2.5, 23: 5})
06:52:56 #*********************************************************************
06:52:56 # Minimum and maximum DeltaR distance                                *
06:52:56 #*********************************************************************
06:52:56 0.0 = drjj    ! min distance between jets
06:52:56 0.0   = drbb    ! min distance between b's
06:52:56 0.0   = drbj    ! min distance between b and jet
06:52:56 -1.0  = drjjmax ! max distance between jets
06:52:56 -1.0  = drbbmax ! max distance between b's
06:52:56 -1.0  = drbjmax ! max distance between b and jet
06:52:56 #*********************************************************************
06:52:56 # Minimum and maximum invariant mass for pairs                       *
06:52:56 #*********************************************************************
06:52:56 0.0   = mmjj    ! min invariant mass of a jet pair
06:52:56 0.0   = mmbb    ! min invariant mass of a b pair
06:52:56 -1.0  = mmjjmax ! max invariant mass of a jet pair
06:52:56 -1.0  = mmbbmax ! max invariant mass of a b pair
06:52:56 {} = mxx_min_pdg ! min invariant mass of a pair of particles X/X~ (e.g. {6:250})
06:52:56 {'default': False} = mxx_only_part_antipart ! if True the invariant mass is applied only
06:52:56 ! to pairs of particle/antiparticle and not to pairs of the same pdg codes.
06:52:56 #*********************************************************************
06:52:56 # Inclusive cuts                                                     *
06:52:56 #*********************************************************************
06:52:56 0.0  = ptheavy   ! minimum pt for at least one heavy final state
06:52:56 0.0  = xptj ! minimum pt for at least one jet
06:52:56 0.0  = xptb ! minimum pt for at least one b
06:52:56 #*********************************************************************
06:52:56 # Control the pt's of the jets sorted by pt                          *
06:52:56 #*********************************************************************
06:52:56 0.0   = ptj1min ! minimum pt for the leading jet in pt
06:52:56 0.0   = ptj2min ! minimum pt for the second jet in pt
06:52:56 -1.0  = ptj1max ! maximum pt for the leading jet in pt
06:52:56 -1.0  = ptj2max ! maximum pt for the second jet in pt
06:52:56 0   = cutuse  ! reject event if fails any (0) / all (1) jet pt cuts
06:52:56 #*********************************************************************
06:52:56 # Control the Ht(k)=Sum of k leading jets                            *
06:52:56 #*********************************************************************
06:52:56 0.0   = htjmin ! minimum jet HT=Sum(jet pt)
06:52:56 -1.0  = htjmax ! maximum jet HT=Sum(jet pt)
06:52:56 0.0   = ihtmin  !inclusive Ht for all partons (including b)
06:52:56 -1.0  = ihtmax  !inclusive Ht for all partons (including b)
06:52:56 #*********************************************************************
06:52:56 # WBF cuts                                                           *
06:52:56 #*********************************************************************
06:52:56 0.0   = xetamin ! minimum rapidity for two jets in the WBF case
06:52:56 0.0   = deltaeta ! minimum rapidity for two jets in the WBF case
06:52:56 #*********************************************************************
06:52:56 # maximal pdg code for quark to be considered as a light jet         *
06:52:56 # (otherwise b cuts are applied)                                     *
06:52:56 #*********************************************************************
06:52:56 4 = maxjetflavor    ! Maximum jet pdg code
06:52:56 #*********************************************************************
06:52:56 #
06:52:56 #*********************************************************************
06:52:56 # Store info for systematics studies                                 *
06:52:56 # WARNING: Do not use for interference type of computation           *
06:52:56 #*********************************************************************
06:52:56 True  = use_syst        ! Enable systematics studies
06:52:56 #
06:52:56 systematics = systematics_program   ! none, systematics [python], SysCalc [depreceted, C++]
06:52:56 ['--mur=0.5,1.0,2.0','--dyn=-1','--muf=0.5,1.0,2.0','--weight_info=MUR%(mur).1f_MUF%(muf).1f_PDF%(pdf)i','--pdf=NNPDF30_nlo_as_0118,PDF4LHC15_nlo_30_pdfas,NNPDF30_nlo_as_0119@0,NNPDF30_nlo_as_0117@0,CT14nlo@0,MMHT2014nlo68clas118@0','--remove_wgts=".*MUR0.5_MUF2.0.*|.*MUR2.0_MUF0.5.*"'] = systematics_arguments   ! see: https://cp3.irmp.ucl.ac.be/projects/madgraph/wiki/Systematics#Systematicspythonmodule
06:52:56 # Syscalc is deprecated but to see the associate options type'update syscalc'
06:52:56  123456   = python_seed
