06:52:56 set group_subprocesses Auto
06:52:56 set ignore_six_quark_processes False
06:52:56 set max_t_for_channel 99
06:52:56 set loop_optimized_output True
06:52:56 set low_mem_multicore_nlo_generation False
06:52:56 set default_unset_couplings 99
06:52:56 set zerowidth_tchannel True
06:52:56 set loop_color_flows False
