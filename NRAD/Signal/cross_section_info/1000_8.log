08:51:30 #*     run as ./bin/mg5_aMC  filename                       *
08:51:30 #*                                                          *
08:51:30 #************************************************************
08:51:30 set group_subprocesses Auto
08:51:30 set ignore_six_quark_processes False
08:51:30 set max_t_for_channel 99
08:51:30 set loop_optimized_output True
08:51:30 set low_mem_multicore_nlo_generation False
08:51:30 set default_unset_couplings 99
08:51:30 set zerowidth_tchannel True
08:51:30 set loop_color_flows False
08:51:30 set gauge unitary
08:51:30 set complex_mass_scheme False
