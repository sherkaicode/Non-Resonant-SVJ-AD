08:51:30 import model /cvmfs/atlas.cern.ch/repo/sw/Generators/madgraph/models/l\
08:51:30 atest/DM/DMsimp_tchannel
08:51:30 define p = g u c d s u~ c~ d~ s~
08:51:30 define j = g u c d s u~ c~ d~ s~
08:51:30 define l+ = e+ mu+
08:51:30 define l- = e- mu-
08:51:30 define vl = ve vm vt
08:51:30 define vl~ = ve~ vm~ vt~
08:51:30 define gv = gv11 gv12 gv21 gv22
08:51:30 define gv~ = gv11~ gv12~ gv21~ gv22~
08:51:30 define j = g u c t d b s g u~ c~ t~ d~ b~ s~
08:51:30 generate p p > gv gv~
08:51:30 add process p p > gv gv~ j
08:51:30 add process p p > gv gv~ j j
08:51:30 output -f -nojpeg
08:51:30 Py:MadGraphUtils     INFO run_card:
08:51:30 #*********************************************************************
08:51:30 #                       MadGraph5_aMC@NLO                            *
08:51:30 #                                                                    *
08:51:30 #                     run_card.dat MadEvent                          *
08:51:30 #                                                                    *
08:51:30 #  This file is used to set the parameters of the run.               *
08:51:30 #                                                                    *
08:51:30 #  Some notation/conventions:                                        *
08:51:30 #                                                                    *
08:51:30 #   Lines starting with a '# ' are info or comments                  *
08:51:30 #                                                                    *
08:51:30 #   mind the format:   value    = variable     ! comment             *
08:51:30 #                                                                    *
08:51:30 #   To display more options, you can type the command:               *
08:51:30 #      update full_run_card                                          *
08:51:30 #*********************************************************************
08:51:30 #
08:51:30 #*********************************************************************
08:51:30 # Tag name for the run (one word)                                    *
08:51:30 #*********************************************************************
08:51:30 tag_1     = run_tag ! name of the run
08:51:30 #*********************************************************************
08:51:30 # Number of events and rnd seed                                      *
08:51:30 # Warning: Do not generate more than 1M events in a single run       *
08:51:30 #*********************************************************************
08:51:30 1500000 = nevents   ! Number of unweighted events requested
08:51:30 123456   = iseed     ! rnd seed (0=assigned automatically=default))
08:51:30 #*********************************************************************
08:51:30 # Collider type and energy                                           *
08:51:30 # lpp: 0=No PDF, 1=proton, -1=antiproton, 2=photon from proton,      *
08:51:30 #                3=photon from electron, 4=photon from muon          *
08:51:30 #*********************************************************************
08:51:30 1        = lpp1    ! beam 1 type
08:51:30 1        = lpp2    ! beam 2 type
08:51:30 6500.0     = ebeam1    ! beam 1 total energy in GeV
08:51:30 6500.0     = ebeam2    ! beam 2 total energy in GeV
08:51:30 # To see polarised beam options: type "update beam_pol"
08:51:30 
08:51:30 #*********************************************************************
08:51:30 # PDF CHOICE: this automatically fixes also alpha_s and its evol.    *
08:51:30 #*********************************************************************
08:51:30 lhapdf    = pdlabel       ! PDF set
08:51:30 260000    = lhaid       ! if pdlabel=lhapdf, this is the lhapdf number
08:51:30 # To see heavy ion options: type "update ion_pdf"
08:51:30 #*********************************************************************
08:51:30 # Renormalization and factorization scales                           *
08:51:30 #*********************************************************************
08:51:30 False = fixed_ren_scale  ! if .true. use fixed ren scale
08:51:30 False        = fixed_fac_scale  ! if .true. use fixed fac scale
08:51:30 91.188  = scale            ! fixed ren scale
08:51:30 91.188  = dsqrt_q2fact1    ! fixed fact scale for pdf1
08:51:30 91.188  = dsqrt_q2fact2    ! fixed fact scale for pdf2
08:51:30 -1 = dynamical_scale_choice ! Choose one of the preselected dynamical choices
08:51:30 1.0  = scalefact        ! scale factor for event-by-event scales
08:51:30 #*********************************************************************
08:51:30 # Type and output format
08:51:30 #*********************************************************************
08:51:30 False     = gridpack  !True = setting up the grid pack
08:51:30 -1.0 = time_of_flight ! threshold (in mm) below which the invariant livetime is not written (-1 means not written)
08:51:30 average =  event_norm       ! average/sum. Normalization of the weight in the LHEF
08:51:30 #*********************************************************************
08:51:30 # Matching parameter (MLM only)
08:51:30 #*********************************************************************
08:51:30 1 = ickkw            ! 0 no matching, 1 MLM
08:51:30 1.0 = alpsfact         ! scale factor for QCD emission vx
08:51:30 False = chcluster        ! cluster only according to channel diag
08:51:30 4 = asrwgtflavor     ! highest quark flavor for a_s reweight
08:51:30 True  = auto_ptj_mjj  ! Automatic setting of ptj and mjj if xqcut >0
08:51:30 ! (turn off for VBF and single top processes)
08:51:30 100   = xqcut     ! minimum kt jet measure between partons
08:51:30 
08:51:30 #***********************************************************************
08:51:30 # Turn on either the ktdurham or ptlund cut to activate                *
08:51:30 # CKKW(L) merging with Pythia8 [arXiv:1410.3012, arXiv:1109.4829]      *
08:51:30 #***********************************************************************
08:51:30 -1.0  =  ktdurham
08:51:30 0.4   =  dparameter
08:51:30 -1.0  =  ptlund
08:51:30 1, 2, 3, 4, 5, 6, 21, 9000005, 9000006, 9000007, 9000008, 9000009, 9000010, 9000011, 9000012, 9000013, 9000014, 9000015, 9000016, 9000017, 9000018, 9000019, 9000020, 9000021, 9000022, 9000023, 9000024, 9000025, 9000026, 9000027, 9000028  =  pdgs_for_merging_cut ! PDGs for two cuts above
08:51:30 
08:51:30 #*********************************************************************
08:51:30 #
08:51:30 #*********************************************************************
08:51:30 # handling of the helicities:
08:51:30 #  0: sum over all helicities
08:51:30 #  1: importance sampling over helicities
08:51:30 #*********************************************************************
08:51:30 0  = nhel          ! using helicities importance sampling or not.
08:51:30 #*********************************************************************
08:51:30 # Generation bias, check the wiki page below for more information:   *
08:51:30 #  'cp3.irmp.ucl.ac.be/projects/madgraph/wiki/LOEventGenerationBias' *
08:51:30 #*********************************************************************
08:51:30 None = bias_module  ! Bias type of bias, [None, ptj_bias, -custom_folder-]
08:51:30 {} = bias_parameters ! Specifies the parameters of the module.
08:51:30 #
08:51:30 #*******************************
08:51:30 # Parton level cuts definition *
08:51:30 #*******************************
08:51:30 #
08:51:30 #
08:51:30 #*********************************************************************
08:51:30 # BW cutoff (M+/-bwcutoff*Gamma) ! Define on/off-shell for "$" and decay
08:51:30 #*********************************************************************
08:51:30 15.0  = bwcutoff      ! (M+/-bwcutoff*Gamma)
08:51:30 #*********************************************************************
08:51:30 # Standard Cuts                                                      *
08:51:30 #*********************************************************************
08:51:30 # Minimum and maximum pt's (for max, -1 means no cut)                *
08:51:30 #*********************************************************************
08:51:30 20.0  = ptj       ! minimum pt for the jets
08:51:30 0.0  = ptb       ! minimum pt for the b
08:51:30 -1.0  = ptjmax    ! maximum pt for the jets
08:51:30 -1.0  = ptbmax    ! maximum pt for the b
08:51:30 {} = pt_min_pdg ! pt cut for other particles (use pdg code). Applied on particle and anti-particle
08:51:30 {}	= pt_max_pdg ! pt cut for other particles (syntax e.g. {6: 100, 25: 50})
08:51:30 #
08:51:30 # For display option for energy cut in the partonic center of mass frame type 'update ecut'
08:51:30 #
08:51:30 #*********************************************************************
08:51:30 # Maximum and minimum absolute rapidity (for max, -1 means no cut)   *
08:51:30 #*********************************************************************
08:51:30 5.0 = etaj    ! max rap for the jets
08:51:30 -1.0  = etab    ! max rap for the b
08:51:30 0.0  = etabmin ! min rap for the b
08:51:30 {} = eta_min_pdg ! rap cut for other particles (use pdg code). Applied on particle and anti-particle
08:51:30 {} = eta_max_pdg ! rap cut for other particles (syntax e.g. {6: 2.5, 23: 5})
08:51:30 #*********************************************************************
08:51:30 # Minimum and maximum DeltaR distance                                *
08:51:30 #*********************************************************************
08:51:30 0.0 = drjj    ! min distance between jets
08:51:30 0.0   = drbb    ! min distance between b's
08:51:30 0.0   = drbj    ! min distance between b and jet
08:51:30 -1.0  = drjjmax ! max distance between jets
08:51:30 -1.0  = drbbmax ! max distance between b's
08:51:30 -1.0  = drbjmax ! max distance between b and jet
08:51:30 #*********************************************************************
08:51:30 # Minimum and maximum invariant mass for pairs                       *
08:51:30 #*********************************************************************
08:51:30 0.0   = mmjj    ! min invariant mass of a jet pair
08:51:30 0.0   = mmbb    ! min invariant mass of a b pair
08:51:30 -1.0  = mmjjmax ! max invariant mass of a jet pair
08:51:30 -1.0  = mmbbmax ! max invariant mass of a b pair
08:51:30 {} = mxx_min_pdg ! min invariant mass of a pair of particles X/X~ (e.g. {6:250})
08:51:30 {'default': False} = mxx_only_part_antipart ! if True the invariant mass is applied only
08:51:30 ! to pairs of particle/antiparticle and not to pairs of the same pdg codes.
08:51:30 #*********************************************************************
08:51:30 # Inclusive cuts                                                     *
08:51:30 #*********************************************************************
08:51:30 0.0  = ptheavy   ! minimum pt for at least one heavy final state
08:51:30 0.0  = xptj ! minimum pt for at least one jet
08:51:30 0.0  = xptb ! minimum pt for at least one b
08:51:30 #*********************************************************************
08:51:30 # Control the pt's of the jets sorted by pt                          *
08:51:30 #*********************************************************************
08:51:30 0.0   = ptj1min ! minimum pt for the leading jet in pt
08:51:30 0.0   = ptj2min ! minimum pt for the second jet in pt
08:51:30 -1.0  = ptj1max ! maximum pt for the leading jet in pt
08:51:30 -1.0  = ptj2max ! maximum pt for the second jet in pt
08:51:30 0   = cutuse  ! reject event if fails any (0) / all (1) jet pt cuts
08:51:30 #*********************************************************************
08:51:30 # Control the Ht(k)=Sum of k leading jets                            *
08:51:30 #*********************************************************************
08:51:30 0.0   = htjmin ! minimum jet HT=Sum(jet pt)
08:51:30 -1.0  = htjmax ! maximum jet HT=Sum(jet pt)
08:51:30 0.0   = ihtmin  !inclusive Ht for all partons (including b)
08:51:30 -1.0  = ihtmax  !inclusive Ht for all partons (including b)
08:51:30 #*********************************************************************
08:51:30 # WBF cuts                                                           *
08:51:30 #*********************************************************************
08:51:30 0.0   = xetamin ! minimum rapidity for two jets in the WBF case
08:51:30 0.0   = deltaeta ! minimum rapidity for two jets in the WBF case
08:51:30 #*********************************************************************
08:51:30 # maximal pdg code for quark to be considered as a light jet         *
08:51:30 # (otherwise b cuts are applied)                                     *
08:51:30 #*********************************************************************
08:51:30 4 = maxjetflavor    ! Maximum jet pdg code
08:51:30 #*********************************************************************
08:51:30 #
08:51:30 #*********************************************************************
08:51:30 # Store info for systematics studies                                 *
08:51:30 # WARNING: Do not use for interference type of computation           *
08:51:30 #*********************************************************************
08:51:30 True  = use_syst        ! Enable systematics studies
08:51:30 #
08:51:30 systematics = systematics_program   ! none, systematics [python], SysCalc [depreceted, C++]
08:51:30 ['--mur=0.5,1.0,2.0','--dyn=-1','--muf=0.5,1.0,2.0','--weight_info=MUR%(mur).1f_MUF%(muf).1f_PDF%(pdf)i','--pdf=NNPDF30_nlo_as_0118,PDF4LHC15_nlo_30_pdfas,NNPDF30_nlo_as_0119@0,NNPDF30_nlo_as_0117@0,CT14nlo@0,MMHT2014nlo68clas118@0','--remove_wgts=".*MUR0.5_MUF2.0.*|.*MUR2.0_MUF0.5.*"'] = systematics_arguments   ! see: https://cp3.irmp.ucl.ac.be/projects/madgraph/wiki/Systematics#Systematicspythonmodule
08:51:30 # Syscalc is deprecated but to see the associate options type'update syscalc'
08:51:30  123456   = python_seed
