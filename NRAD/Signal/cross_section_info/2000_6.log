14:41:36 set group_subprocesses Auto
14:41:36 set ignore_six_quark_processes False
14:41:36 set max_t_for_channel 99
14:41:36 set loop_optimized_output True
14:41:36 set low_mem_multicore_nlo_generation False
14:41:36 set default_unset_couplings 99
14:41:36 set zerowidth_tchannel True
