14:14:15 #*     run as ./bin/mg5_aMC  filename                       *
14:14:15 #*                                                          *
14:14:15 #************************************************************
14:14:15 set group_subprocesses Auto
14:14:15 set ignore_six_quark_processes False
14:14:15 set max_t_for_channel 99
14:14:15 set loop_optimized_output True
14:14:15 set low_mem_multicore_nlo_generation False
14:14:15 set default_unset_couplings 99
14:14:15 set zerowidth_tchannel True
14:14:15 set loop_color_flows False
14:14:15 set gauge unitary
14:14:15 set complex_mass_scheme False
14:14:15 set max_npoint_for_channel 0
14:14:15 import model /cvmfs/atlas.cern.ch/repo/sw/Generators/madgraph/models/l\
14:14:15 atest/DM/DMsimp_tchannel
14:14:15 define p = g u c d s u~ c~ d~ s~
14:14:15 define j = g u c d s u~ c~ d~ s~
14:14:15 define l+ = e+ mu+
14:14:15 define l- = e- mu-
14:14:15 define vl = ve vm vt
14:14:15 define vl~ = ve~ vm~ vt~
14:14:15 define gv = gv11 gv12 gv21 gv22
14:14:15 define gv~ = gv11~ gv12~ gv21~ gv22~
14:14:15 define j = g u c t d b s g u~ c~ t~ d~ b~ s~
14:14:15 generate p p > gv gv~
14:14:15 add process p p > gv gv~ j
14:14:15 add process p p > gv gv~ j j
14:14:15 output -f -nojpeg
14:14:15 Py:MadGraphUtils     INFO run_card:
14:14:15 #*********************************************************************
14:14:15 #                       MadGraph5_aMC@NLO                            *
14:14:15 #                                                                    *
14:14:15 #                     run_card.dat MadEvent                          *
14:14:15 #                                                                    *
14:14:15 #  This file is used to set the parameters of the run.               *
14:14:15 #                                                                    *
14:14:15 #  Some notation/conventions:                                        *
14:14:15 #                                                                    *
14:14:15 #   Lines starting with a '# ' are info or comments                  *
14:14:15 #                                                                    *
14:14:15 #   mind the format:   value    = variable     ! comment             *
14:14:15 #                                                                    *
14:14:15 #   To display more options, you can type the command:               *
14:14:15 #      update full_run_card                                          *
14:14:15 #*********************************************************************
14:14:15 #
14:14:15 #*********************************************************************
14:14:15 # Tag name for the run (one word)                                    *
14:14:15 #*********************************************************************
14:14:15 tag_1     = run_tag ! name of the run
14:14:15 #*********************************************************************
14:14:15 # Number of events and rnd seed                                      *
14:14:15 # Warning: Do not generate more than 1M events in a single run       *
14:14:15 #*********************************************************************
14:14:15 1500000 = nevents   ! Number of unweighted events requested
14:14:15 123456   = iseed     ! rnd seed (0=assigned automatically=default))
14:14:15 #*********************************************************************
14:14:15 # Collider type and energy                                           *
14:14:15 # lpp: 0=No PDF, 1=proton, -1=antiproton, 2=photon from proton,      *
14:14:15 #                3=photon from electron, 4=photon from muon          *
14:14:15 #*********************************************************************
14:14:15 1        = lpp1    ! beam 1 type
14:14:15 1        = lpp2    ! beam 2 type
14:14:15 6500.0     = ebeam1    ! beam 1 total energy in GeV
14:14:15 6500.0     = ebeam2    ! beam 2 total energy in GeV
14:14:15 # To see polarised beam options: type "update beam_pol"
14:14:15 
14:14:15 #*********************************************************************
14:14:15 # PDF CHOICE: this automatically fixes also alpha_s and its evol.    *
14:14:15 #*********************************************************************
14:14:15 lhapdf    = pdlabel       ! PDF set
14:14:15 260000    = lhaid       ! if pdlabel=lhapdf, this is the lhapdf number
14:14:15 # To see heavy ion options: type "update ion_pdf"
14:14:15 #*********************************************************************
14:14:15 # Renormalization and factorization scales                           *
14:14:15 #*********************************************************************
14:14:15 False = fixed_ren_scale  ! if .true. use fixed ren scale
14:14:15 False        = fixed_fac_scale  ! if .true. use fixed fac scale
14:14:15 91.188  = scale            ! fixed ren scale
14:14:15 91.188  = dsqrt_q2fact1    ! fixed fact scale for pdf1
14:14:15 91.188  = dsqrt_q2fact2    ! fixed fact scale for pdf2
14:14:15 -1 = dynamical_scale_choice ! Choose one of the preselected dynamical choices
14:14:15 1.0  = scalefact        ! scale factor for event-by-event scales
14:14:15 #*********************************************************************
14:14:15 # Type and output format
14:14:15 #*********************************************************************
14:14:15 False     = gridpack  !True = setting up the grid pack
14:14:15 -1.0 = time_of_flight ! threshold (in mm) below which the invariant livetime is not written (-1 means not written)
14:14:15 average =  event_norm       ! average/sum. Normalization of the weight in the LHEF
14:14:15 #*********************************************************************
14:14:15 # Matching parameter (MLM only)
14:14:15 #*********************************************************************
14:14:15 1 = ickkw            ! 0 no matching, 1 MLM
14:14:15 1.0 = alpsfact         ! scale factor for QCD emission vx
14:14:15 False = chcluster        ! cluster only according to channel diag
14:14:15 4 = asrwgtflavor     ! highest quark flavor for a_s reweight
14:14:15 True  = auto_ptj_mjj  ! Automatic setting of ptj and mjj if xqcut >0
14:14:15 ! (turn off for VBF and single top processes)
14:14:15 100   = xqcut     ! minimum kt jet measure between partons
14:14:15 
14:14:15 #***********************************************************************
14:14:15 # Turn on either the ktdurham or ptlund cut to activate                *
14:14:15 # CKKW(L) merging with Pythia8 [arXiv:1410.3012, arXiv:1109.4829]      *
14:14:15 #***********************************************************************
14:14:15 -1.0  =  ktdurham
14:14:15 0.4   =  dparameter
14:14:15 -1.0  =  ptlund
14:14:15 1, 2, 3, 4, 5, 6, 21, 9000005, 9000006, 9000007, 9000008, 9000009, 9000010, 9000011, 9000012, 9000013, 9000014, 9000015, 9000016, 9000017, 9000018, 9000019, 9000020, 9000021, 9000022, 9000023, 9000024, 9000025, 9000026, 9000027, 9000028  =  pdgs_for_merging_cut ! PDGs for two cuts above
14:14:15 
14:14:15 #*********************************************************************
14:14:15 #
14:14:15 #*********************************************************************
14:14:15 # handling of the helicities:
14:14:15 #  0: sum over all helicities
14:14:15 #  1: importance sampling over helicities
14:14:15 #*********************************************************************
14:14:15 0  = nhel          ! using helicities importance sampling or not.
14:14:15 #*********************************************************************
14:14:15 # Generation bias, check the wiki page below for more information:   *
14:14:15 #  'cp3.irmp.ucl.ac.be/projects/madgraph/wiki/LOEventGenerationBias' *
14:14:15 #*********************************************************************
14:14:15 None = bias_module  ! Bias type of bias, [None, ptj_bias, -custom_folder-]
14:14:15 {} = bias_parameters ! Specifies the parameters of the module.
14:14:15 #
14:14:15 #*******************************
14:14:15 # Parton level cuts definition *
14:14:15 #*******************************
14:14:15 #
14:14:15 #
14:14:15 #*********************************************************************
14:14:15 # BW cutoff (M+/-bwcutoff*Gamma) ! Define on/off-shell for "$" and decay
14:14:15 #*********************************************************************
14:14:15 15.0  = bwcutoff      ! (M+/-bwcutoff*Gamma)
14:14:15 #*********************************************************************
14:14:15 # Standard Cuts                                                      *
14:14:15 #*********************************************************************
14:14:15 # Minimum and maximum pt's (for max, -1 means no cut)                *
14:14:15 #*********************************************************************
14:14:15 20.0  = ptj       ! minimum pt for the jets
14:14:15 0.0  = ptb       ! minimum pt for the b
14:14:15 -1.0  = ptjmax    ! maximum pt for the jets
14:14:15 -1.0  = ptbmax    ! maximum pt for the b
14:14:15 {} = pt_min_pdg ! pt cut for other particles (use pdg code). Applied on particle and anti-particle
14:14:15 {}	= pt_max_pdg ! pt cut for other particles (syntax e.g. {6: 100, 25: 50})
14:14:15 #
14:14:15 # For display option for energy cut in the partonic center of mass frame type 'update ecut'
14:14:15 #
14:14:15 #*********************************************************************
14:14:15 # Maximum and minimum absolute rapidity (for max, -1 means no cut)   *
14:14:15 #*********************************************************************
14:14:15 5.0 = etaj    ! max rap for the jets
14:14:15 -1.0  = etab    ! max rap for the b
14:14:15 0.0  = etabmin ! min rap for the b
14:14:15 {} = eta_min_pdg ! rap cut for other particles (use pdg code). Applied on particle and anti-particle
14:14:15 {} = eta_max_pdg ! rap cut for other particles (syntax e.g. {6: 2.5, 23: 5})
14:14:15 #*********************************************************************
14:14:15 # Minimum and maximum DeltaR distance                                *
14:14:15 #*********************************************************************
14:14:15 0.0 = drjj    ! min distance between jets
14:14:15 0.0   = drbb    ! min distance between b's
14:14:15 0.0   = drbj    ! min distance between b and jet
14:14:15 -1.0  = drjjmax ! max distance between jets
14:14:15 -1.0  = drbbmax ! max distance between b's
14:14:15 -1.0  = drbjmax ! max distance between b and jet
14:14:15 #*********************************************************************
14:14:15 # Minimum and maximum invariant mass for pairs                       *
14:14:15 #*********************************************************************
14:14:15 0.0   = mmjj    ! min invariant mass of a jet pair
14:14:15 0.0   = mmbb    ! min invariant mass of a b pair
14:14:15 -1.0  = mmjjmax ! max invariant mass of a jet pair
14:14:15 -1.0  = mmbbmax ! max invariant mass of a b pair
14:14:15 {} = mxx_min_pdg ! min invariant mass of a pair of particles X/X~ (e.g. {6:250})
14:14:15 {'default': False} = mxx_only_part_antipart ! if True the invariant mass is applied only
14:14:15 ! to pairs of particle/antiparticle and not to pairs of the same pdg codes.
14:14:15 #*********************************************************************
14:14:15 # Inclusive cuts                                                     *
14:14:15 #*********************************************************************
14:14:15 0.0  = ptheavy   ! minimum pt for at least one heavy final state
14:14:15 0.0  = xptj ! minimum pt for at least one jet
14:14:15 0.0  = xptb ! minimum pt for at least one b
14:14:15 #*********************************************************************
14:14:15 # Control the pt's of the jets sorted by pt                          *
14:14:15 #*********************************************************************
14:14:15 0.0   = ptj1min ! minimum pt for the leading jet in pt
14:14:15 0.0   = ptj2min ! minimum pt for the second jet in pt
14:14:15 -1.0  = ptj1max ! maximum pt for the leading jet in pt
14:14:15 -1.0  = ptj2max ! maximum pt for the second jet in pt
14:14:15 0   = cutuse  ! reject event if fails any (0) / all (1) jet pt cuts
14:14:15 #*********************************************************************
14:14:15 # Control the Ht(k)=Sum of k leading jets                            *
14:14:15 #*********************************************************************
14:14:15 0.0   = htjmin ! minimum jet HT=Sum(jet pt)
14:14:15 -1.0  = htjmax ! maximum jet HT=Sum(jet pt)
14:14:15 0.0   = ihtmin  !inclusive Ht for all partons (including b)
14:14:15 -1.0  = ihtmax  !inclusive Ht for all partons (including b)
14:14:15 #*********************************************************************
14:14:15 # WBF cuts                                                           *
14:14:15 #*********************************************************************
14:14:15 0.0   = xetamin ! minimum rapidity for two jets in the WBF case
14:14:15 0.0   = deltaeta ! minimum rapidity for two jets in the WBF case
14:14:15 #*********************************************************************
14:14:15 # maximal pdg code for quark to be considered as a light jet         *
14:14:15 # (otherwise b cuts are applied)                                     *
14:14:15 #*********************************************************************
14:14:15 4 = maxjetflavor    ! Maximum jet pdg code
14:14:15 #*********************************************************************
14:14:15 #
14:14:15 #*********************************************************************
14:14:15 # Store info for systematics studies                                 *
14:14:15 # WARNING: Do not use for interference type of computation           *
14:14:15 #*********************************************************************
14:14:15 True  = use_syst        ! Enable systematics studies
14:14:15 #
14:14:15 systematics = systematics_program   ! none, systematics [python], SysCalc [depreceted, C++]
14:14:15 ['--mur=0.5,1.0,2.0','--dyn=-1','--muf=0.5,1.0,2.0','--weight_info=MUR%(mur).1f_MUF%(muf).1f_PDF%(pdf)i','--pdf=NNPDF30_nlo_as_0118,PDF4LHC15_nlo_30_pdfas,NNPDF30_nlo_as_0119@0,NNPDF30_nlo_as_0117@0,CT14nlo@0,MMHT2014nlo68clas118@0','--remove_wgts=".*MUR0.5_MUF2.0.*|.*MUR2.0_MUF0.5.*"'] = systematics_arguments   ! see: https://cp3.irmp.ucl.ac.be/projects/madgraph/wiki/Systematics#Systematicspythonmodule
14:14:15 # Syscalc is deprecated but to see the associate options type'update syscalc'
14:14:15  123456   = python_seed
